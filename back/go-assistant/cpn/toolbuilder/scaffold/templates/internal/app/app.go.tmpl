// Package app holds application services — use-cases that orchestrate
// ports to fulfil domain behaviour.
package app

import "{{.Module}}/internal/ports"

// Service is the primary use-case holder for {{.Name}}.
type Service struct {
	echo ports.Echo
}

// New returns a Service wired with the given Echo port.
func New(echo ports.Echo) *Service {
	return &Service{echo: echo}
}

// Run executes the tool with the given positional args.
// The default behaviour echoes the joined args; tools generated by the
// atelier overwrite this body during the TDD loop.
func (s *Service) Run(args []string) error {
	return s.echo.Emit(args)
}
