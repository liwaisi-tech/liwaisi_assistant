package app

import (
	"errors"
	"testing"
)

type fakeEcho struct {
	got []string
	err error
}

func (f *fakeEcho) Emit(args []string) error {
	f.got = append([]string{}, args...)
	return f.err
}

func TestService_Run_DelegatesToEcho(t *testing.T) {
	f := &fakeEcho{}
	s := New(f)
	if err := s.Run([]string{"a", "b"}); err != nil {
		t.Fatalf("Run: %v", err)
	}
	if len(f.got) != 2 || f.got[0] != "a" || f.got[1] != "b" {
		t.Errorf("echo got %v, want [a b]", f.got)
	}
}

func TestService_Run_PropagatesError(t *testing.T) {
	want := errors.New("boom")
	s := New(&fakeEcho{err: want})
	if got := s.Run(nil); !errors.Is(got, want) {
		t.Errorf("Run err = %v, want %v", got, want)
	}
}

func TestNew_NotNil(t *testing.T) {
	if New(nil) == nil {
		t.Fatal("New returned nil")
	}
}
