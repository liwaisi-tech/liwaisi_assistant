# ── Liwaisi Integration Test Configuration ──────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp integration/testdata/.env.example integration/testdata/.env
#
# Then run:
#   source integration/testdata/.env && make test-integration

# Required: OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Override the default model (cheapest for testing)
# DEFAULT_MODEL=minimax/minimax-m2.7

# Optional: Log level for server output during tests
# LOG_LEVEL=error
