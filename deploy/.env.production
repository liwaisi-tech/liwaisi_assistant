# ============================================================================
# BRAE Production Environment Variables
# Copy to .env in the project root and fill in all values.
# ============================================================================

# ── Required ─────���──────────────────────────────────────────────────────────

# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# PostgreSQL password (use a strong random password)
POSTGRES_PASSWORD=

# Admin email (your Google account email for admin panel access)
ADMIN_EMAIL=

# ── Security ───────��────────────────────────────────────────────────────────

# CORS: restrict to your domain only
CORS_ORIGINS=https://brae.liwaisi.tech

# Allowed emails: comma-separated list of Google emails that can access.
# Leave empty to allow anyone with a Google account.
# Example: user1@gmail.com,user2@gmail.com
ALLOWED_EMAILS=

# ── Optional ───────────��──────────────────────────���─────────────────────────

# DEFAULT_MODEL and MODEL_* env variables were removed per
# spec-architecture-model-selection-centralization.md. The product default is
# baked into the backend as openrouter.PRODUCT_DEFAULT_MODEL; users override
# it via the onboarding wizard (stored on users.preferred_model).

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Build version tag
VERSION=1.0.0
