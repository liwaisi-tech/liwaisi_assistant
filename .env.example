# ── Required ────────────────────────────────────────────────
# OpenRouter API key for LLM calls
OPENROUTER_API_KEY=your-api-key-here

# ── Persistence (required from P3 onward) ───────────────────
# Postgres DSN for the persistence layer
# LIWAISI_DB_DSN=postgres://liwaisi:liwaisi_dev@localhost:5432/liwaisi?sslmode=disable

# Docker Compose Postgres password (matches LIWAISI_DB_DSN)
# POSTGRES_PASSWORD=liwaisi_dev

# Redis URL for session cache and HITL repository (P6)
# LIWAISI_REDIS_URL=redis://localhost:6379/0

# ── OpenRouter App Identification ────────────────────────────
# OPENROUTER_APP_URL=https://liwaisi.example.com
# OPENROUTER_APP_TITLE=Liwaisi Assistant

# ── Optional (defaults shown) ──────────────────────────────
# CORS allowed origins (comma-separated)
# CORS_ORIGINS=*

# Default LLM model
# DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Model role overrides (OpenRouter model IDs)
# MODEL_CLASSIFIER=google/gemini-2.0-flash-001
# MODEL_STRUCTURED=anthropic/claude-haiku-4-5-20251001
# MODEL_REASONING=anthropic/claude-sonnet-4-6
# MODEL_LONG_CONTEXT=google/gemini-2.0-pro-001
# MODEL_SUMMARIZE=meta-llama/llama-3.3-8b-instruct
# MODEL_THINKING=anthropic/claude-opus-4-6

# Max output tokens per LLM transition (default values shown)
# MAX_TOKENS_DIRECT=4096
# MAX_TOKENS_PLAN=4096
# MAX_TOKENS_EXECUTE=8192

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Server timeouts
# READ_TIMEOUT=10s
# IDLE_TIMEOUT=120s
# SHUTDOWN_TIMEOUT=30s

# Google OAuth Client ID (for frontend auth)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
